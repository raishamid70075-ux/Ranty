---
---
<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="#home" class="logo">
      <div class="logo-icon"></div>
      <span class="logo-text">RANTY</span>
    </a>

    <ul class="nav-links">
      <li><a href="#services" class="nav-link" data-page="services">Services</a></li>
      <li><a href="#homes" class="nav-link" data-page="homes">Homes</a></li>
      <li><a href="#about" class="nav-link" data-page="about">About us</a></li>
      <li><a href="#cases" class="nav-link" data-page="cases">Cases</a></li>
      <li class="relative dropdown" style="z-index: 100;">
        <a href="#more" class="more-link flex items-center gap-1 hover:text-clay-light transition-colors">
          More
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 9l6 6 6-6"></path></svg>
        </a>
        <div class="dropdown-menu flex flex-col bg-white rounded-xl shadow-xl border border-espresso/10 p-2">
          <a href="#materials" class="px-4 py-2.5 text-sm text-espresso hover:bg-offwhite rounded-lg transition-colors">Materials</a>
          <a href="#pricing" class="px-4 py-2.5 text-sm text-espresso hover:bg-offwhite rounded-lg transition-colors">Pricing</a>
          <a href="#team" class="px-4 py-2.5 text-sm text-espresso hover:bg-offwhite rounded-lg transition-colors">Team</a>
        </div>
      </li>
    </ul>

    <div class="nav-right">
      <button type="button" id="themeToggle" class="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <div class="divider"></div>
      <a href="#contact" class="contact-btn">Contact Us</a>
    </div>

    <!-- Mobile Toggle (Staggered Menu) -->
    <button class="mobile-toggle sm-toggle" type="button" aria-label="Toggle menu" id="mobileToggle" aria-expanded="false" aria-controls="staggered-menu-panel">
      <span class="sm-toggle-textWrap" aria-hidden="true">
        <span class="sm-toggle-textInner" id="smTextInner">
          <span class="sm-toggle-line">Menu</span>
        </span>
      </span>
      <span class="sm-icon" aria-hidden="true">
        <span class="sm-icon-line" id="smIconH"></span>
        <span class="sm-icon-line sm-icon-line-v" id="smIconV"></span>
      </span>
    </button>
  </div>
</nav>

<!-- Staggered Menu (Mobile Only) -->
<div class="sm-scope" id="smScope">
  <div class="sm-prelayers" id="smPrelayers" aria-hidden="true">
    <div class="sm-prelayer" style="background: #2C1E16;"></div>
    <div class="sm-prelayer" style="background: #C27A5E;"></div>
  </div>
  <aside id="staggered-menu-panel" class="staggered-menu-panel" aria-hidden="true" inert>
    <div class="sm-panel-inner">
      <ul class="sm-panel-list" role="list">
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#services"><span class="sm-panel-itemLabel">Services</span></a></li>
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#homes"><span class="sm-panel-itemLabel">Homes</span></a></li>
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#about"><span class="sm-panel-itemLabel">About</span></a></li>
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#cases"><span class="sm-panel-itemLabel">Cases</span></a></li>
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#materials"><span class="sm-panel-itemLabel">Materials</span></a></li>
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#pricing"><span class="sm-panel-itemLabel">Pricing</span></a></li>
        <li class="sm-panel-itemWrap"><a class="sm-panel-item" href="#contact"><span class="sm-panel-itemLabel">Contact</span></a></li>
      </ul>
    </div>
  </aside>
</div>

<style>
  .navbar {
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 50;
    padding: 1rem var(--gutter);
    transition: background 0.3s, box-shadow 0.3s;
  }
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0 0 -2rem 0;
    background: linear-gradient(rgba(var(--shade), 0.55), transparent);
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .navbar.scrolled::before { opacity: 0; }
  .navbar.scrolled {
    background: rgba(244, 242, 238, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .navbar.scrolled a,
  .navbar.scrolled .logo-text,
  .navbar.scrolled .nav-icon,
  .navbar.scrolled button { color: var(--espresso) !important; }
  .navbar.scrolled .contact-btn {
    border-color: var(--espresso) !important;
    color: var(--espresso) !important;
  }

  :global(.dark) .navbar.scrolled { background: rgba(26,23,20,0.95) !important; }
  :global(.dark) .navbar.scrolled a,
  :global(.dark) .navbar.scrolled .logo-text,
  :global(.dark) .navbar.scrolled button { color: #e8ddd3 !important; }
  :global(.dark) .navbar.scrolled .contact-btn { border-color: #e8ddd3 !important; color: #e8ddd3 !important; }
  :global(.dark) .navbar.scrolled .theme-toggle .icon-sun { display: none; }
  :global(.dark) .navbar.scrolled .theme-toggle .icon-moon { display: block; }
  :global(.dark) .navbar::before { background: linear-gradient(rgba(15,13,10,0.7), transparent) !important; }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #fff;
  }
  .logo-icon {
    width: 26px;
    height: 26px;
    background: currentColor;
    border-radius: 4px;
    transition: transform 0.3s;
  }
  .logo:hover .logo-icon { transform: rotate(45deg); }
  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #fff;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 2rem;
    list-style: none;
    overflow: visible;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.3s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--terracotta);
    transition: width 0.3s ease;
    opacity: 0;
  }
  .navbar.scrolled .nav-links a::after { opacity: 1; }
  .nav-links a:hover::after { width: 100%; }
  .nav-links a:hover { color: var(--clay-light); }
  .nav-links svg { width: 12px; height: 12px; }
  .dropdown-menu a { color: var(--espresso) !important; }
  .dropdown-menu a::after { background: var(--espresso); }
  .dropdown-menu a:hover { background-color: var(--offwhite); color: var(--espresso) !important; }

  .nav-right {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-right button {
    background: none;
    border: none;
    color: #fff;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.3s;
  }
  .nav-right button:hover { color: var(--clay-light); }
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
  }
  .theme-toggle .icon-moon { display: none; }
  .theme-toggle .icon-sun { display: block; }
  :global(.dark) .theme-toggle .icon-moon { display: block; }
  :global(.dark) .theme-toggle .icon-sun { display: none; }
  .contact-btn {
    color: #fff;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
    transition: all 0.3s;
  }
  .contact-btn:hover { color: var(--clay-light); border-color: var(--clay-light); }
  .divider {
    width: 1px;
    height: 16px;
    background: currentColor;
    opacity: 0.3;
  }

  /* ===== MOBILE TOGGLE (Staggered Menu Button) ===== */
  .mobile-toggle {
    display: none;
  }
  .sm-toggle {
    position: relative;
    display: none;
    align-items: center;
    gap: 0.3rem;
    background: transparent;
    border: none;
    color: #fff;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    overflow: visible;
    padding: 0;
    z-index: 60;
  }
  .sm-toggle-textWrap {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden;
    white-space: nowrap;
  }
  .sm-toggle-textInner {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .sm-toggle-line {
    display: block;
    height: 1em;
    line-height: 1;
  }
  .sm-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
  }
  .sm-icon-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transform: translate(-50%, -50%);
    will-change: transform;
  }
  .sm-icon-line-v {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* ===== STAGGERED MENU PANEL (Mobile Only) ===== */
  .sm-scope {
    display: none;
  }
  .sm-prelayers {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    pointer-events: none;
    z-index: 41;
    opacity: 0;
  }
  .sm-prelayer {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 100%;
    transform: translateX(0);
    opacity: 0;
  }
  .staggered-menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: #F4F2EE;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    padding: 7rem 2rem 3rem 2rem;
    overflow-y: auto;
    z-index: 42;
    pointer-events: auto;
    opacity: 0;
  }
  .sm-panel-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sm-panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sm-panel-itemWrap {
    position: relative;
    overflow: hidden;
    line-height: 1;
  }
  .sm-panel-item {
    position: relative;
    color: var(--espresso);
    font-weight: 600;
    font-size: clamp(2.5rem, 8vw, 4rem);
    cursor: pointer;
    line-height: 1;
    letter-spacing: -2px;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s;
    display: inline-block;
    text-decoration: none;
    padding-right: 1.4em;
  }
  .sm-panel-itemLabel {
    display: inline-block;
    will-change: transform;
    transform-origin: 50% 100%;
  }
  .sm-panel-item:hover {
    color: var(--terracotta);
  }

  /* Dark mode staggered panel */
  :global(.dark) .staggered-menu-panel { background: #1a1714 !important; }
  :global(.dark) .sm-panel-item { color: #e8ddd3 !important; }
  :global(.dark) .sm-panel-item:hover { color: #d4956f !important; }
  :global(.dark) .sm-prelayer:nth-child(1) { background: #252017 !important; }
  :global(.dark) .sm-prelayer:nth-child(2) { background: #a85f43 !important; }

  @media (min-width: 768px) {
    .nav-links, .nav-right { display: flex; }
    .mobile-toggle { display: none !important; }
    .sm-toggle { display: none !important; }
    .sm-scope { display: none !important; }
  }

  @media (max-width: 767px) {
    .sm-toggle { display: inline-flex; }
    .sm-scope { display: block; }
  }

  .dropdown-menu {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    top: 100%;
    padding-top: 0.5rem;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    pointer-events: none;
  }
  .dropdown:hover > .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  :global(.dark) .dropdown-menu {
    background-color: #252017 !important;
    border-color: rgba(232,221,211,0.1) !important;
  }
  :global(.dark) .dropdown-menu a {
    color: #e8ddd3 !important;
  }
  :global(.dark) .dropdown-menu a:hover {
    background-color: #302a20 !important;
  }

  /* Body scroll lock */
  :global(body.sm-open) {
    overflow: hidden !important;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const navbar = document.getElementById('navbar');
  const mobileToggle = document.getElementById('mobileToggle');
  const smScope = document.getElementById('smScope');
  const panel = document.getElementById('staggered-menu-panel');
  const prelayers = document.getElementById('smPrelayers');
  const iconH = document.getElementById('smIconH');
  const iconV = document.getElementById('smIconV');
  const textInner = document.getElementById('smTextInner');
  const themeToggle = document.getElementById('themeToggle');
  const html = document.documentElement;

  let isOpen = false;
  let busy = false;
  let openTl = null;
  let closeTween = null;
  let spinTween = null;
  let textCycleAnim = null;
  let colorTween = null;

  const menuButtonColor = '#fff';
  const openMenuButtonColor = '#fff';

  // Scroll handler
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 50);
  });

  // Dark mode
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    html.classList.add('dark');
  }
  themeToggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Initialize GSAP state
  function initGSAP() {
    if (!panel || !prelayers || !iconH || !iconV || !textInner) return;
    const layerEls = Array.from(prelayers.querySelectorAll('.sm-prelayer'));
    gsap.set([panel, ...layerEls], { xPercent: 100, opacity: 1 });
    gsap.set(prelayers, { xPercent: 0, opacity: 1 });
    gsap.set(iconH, { transformOrigin: '50% 50%', rotate: 0 });
    gsap.set(iconV, { transformOrigin: '50% 50%', rotate: 90 });
    gsap.set(textInner, { yPercent: 0 });
  }
  initGSAP();

  // Build open timeline
  function buildOpenTimeline() {
    if (!panel || !prelayers) return null;
    openTl?.kill();
    if (closeTween) { closeTween.kill(); closeTween = null; }

    const layerEls = Array.from(prelayers.querySelectorAll('.sm-prelayer'));
    const itemEls = Array.from(panel.querySelectorAll('.sm-panel-itemLabel'));

    if (itemEls.length) gsap.set(itemEls, { yPercent: 140, rotate: 10 });

    const tl = gsap.timeline({ paused: true });

    // Pre-layers stagger
    layerEls.forEach((el, i) => {
      tl.fromTo(el, { xPercent: 100 }, { xPercent: 0, duration: 0.5, ease: 'power4.out' }, i * 0.07);
    });

    const lastTime = layerEls.length ? (layerEls.length - 1) * 0.07 : 0;
    const panelInsertTime = lastTime + (layerEls.length ? 0.08 : 0);
    const panelDuration = 0.65;

    // Panel entrance
    tl.fromTo(panel, { xPercent: 100 }, { xPercent: 0, duration: panelDuration, ease: 'power4.out' }, panelInsertTime);

    // Items stagger
    if (itemEls.length) {
      const itemsStart = panelInsertTime + panelDuration * 0.15;
      tl.to(itemEls, {
        yPercent: 0, rotate: 0, duration: 1, ease: 'power4.out',
        stagger: { each: 0.1, from: 'start' }
      }, itemsStart);
    }

    openTl = tl;
    return tl;
  }

  // Play open
  function playOpen() {
    if (busy) return;
    busy = true;
    const tl = buildOpenTimeline();
    if (tl) {
      tl.eventCallback('onComplete', () => { busy = false; });
      tl.play(0);
    } else {
      busy = false;
    }
  }

  // Play close
  function playClose() {
    openTl?.kill();
    openTl = null;

    if (!panel || !prelayers) return;
    const layerEls = Array.from(prelayers.querySelectorAll('.sm-prelayer'));
    const all = [...layerEls, panel];

    closeTween?.kill();
    closeTween = gsap.to(all, {
      xPercent: 100,
      duration: 0.32,
      ease: 'power3.in',
      overwrite: 'auto',
      onComplete: () => {
        const itemEls = Array.from(panel.querySelectorAll('.sm-panel-itemLabel'));
        if (itemEls.length) gsap.set(itemEls, { yPercent: 140, rotate: 10 });
        busy = false;
      }
    });
  }

  // Animate icon (plus -> X)
  function animateIcon(opening) {
    if (!iconH || !iconV) return;
    spinTween?.kill();
    if (opening) {
      spinTween = gsap.to(iconH, { rotate: 45, duration: 0.5, ease: 'power4.out', overwrite: 'auto' });
      gsap.to(iconV, { rotate: -45, duration: 0.5, ease: 'power4.out', overwrite: 'auto' });
    } else {
      spinTween = gsap.to(iconH, { rotate: 0, duration: 0.35, ease: 'power3.inOut', overwrite: 'auto' });
      gsap.to(iconV, { rotate: 90, duration: 0.35, ease: 'power3.inOut', overwrite: 'auto' });
    }
  }

  // Animate text (Menu -> Close)
  function animateText(opening) {
    if (!textInner) return;
    textCycleAnim?.kill();

    const currentLabel = opening ? 'Menu' : 'Close';
    const targetLabel = opening ? 'Close' : 'Menu';
    const cycles = 3;
    const seq = [currentLabel];
    let last = currentLabel;
    for (let i = 0; i < cycles; i++) {
      last = last === 'Menu' ? 'Close' : 'Menu';
      seq.push(last);
    }
    if (last !== targetLabel) seq.push(targetLabel);
    seq.push(targetLabel);

    // Update text lines
    textInner.innerHTML = seq.map(l => `<span class="sm-toggle-line">${l}</span>`).join('');

    gsap.set(textInner, { yPercent: 0 });
    const lineCount = seq.length;
    const finalShift = ((lineCount - 1) / lineCount) * 100;
    textCycleAnim = gsap.to(textInner, {
      yPercent: -finalShift,
      duration: 0.5 + lineCount * 0.07,
      ease: 'power4.out'
    });
  }

  // Toggle menu
  function toggleMenu() {
    if (busy) return;
    const target = !isOpen;
    isOpen = target;

    mobileToggle?.setAttribute('aria-expanded', String(target));
    panel?.setAttribute('aria-hidden', String(!target));
    panel?.toggleAttribute('inert', !target);

    if (target) {
      document.body.classList.add('sm-open');
      playOpen();
    } else {
      document.body.classList.remove('sm-open');
      playClose();
    }
    animateIcon(target);
    animateText(target);
  }

  // Close menu
  function closeMenu() {
    if (!isOpen) return;
    isOpen = false;
    mobileToggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('aria-hidden', 'true');
    panel?.toggleAttribute('inert', true);
    document.body.classList.remove('sm-open');
    playClose();
    animateIcon(false);
    animateText(false);
  }

  // Event listeners
  mobileToggle?.addEventListener('click', toggleMenu);

  // Close on link click
  panel?.querySelectorAll('.sm-panel-item').forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Close on click away
  document.addEventListener('mousedown', (e) => {
    if (!isOpen) return;
    if (panel && !panel.contains(e.target) && mobileToggle && !mobileToggle.contains(e.target)) {
      closeMenu();
    }
  });
</script>
