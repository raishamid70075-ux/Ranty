---
---
<section id="materials" class="scroll-mt-20 py-24 md:py-32 px-6 lg:px-16 bg-offwhite">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center materials-content">
      <div class="bg-terracotta rounded-tr-[80px] rounded-bl-[32px] rounded-tl-[32px] p-8 md:p-12 text-white relative overflow-hidden">
        <div class="relative z-10">
          <h2 class="font-serif text-2xl md:text-4xl mb-4">We use best materials!</h2>
          <p class="text-white/80 mb-8 max-w-md">Kami hanya bekerja sama dengan supplier terverifikasi untuk memastikan ketahanan dan keindahan rumah Anda selama puluhan tahun.</p>
          <div class="w-full h-64 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm border border-white/30">
            <span class="text-sm font-medium uppercase tracking-widest">Cutaway Diagram Dinding</span>
          </div>
        </div>
        <div class="absolute -bottom-20 -right-20 w-64 h-64 bg-white/10 rounded-full"></div>
      </div>
      <div>
        <h3 class="font-serif text-xl md:text-3xl text-espresso mb-6 scroll-reveal">Certifications & Partners</h3>
        <div class="space-y-6">
          <div class="flex items-center gap-4 bg-white p-4 rounded-2xl shadow-sm">
            <div class="w-12 h-12 bg-espresso rounded-full flex items-center justify-center text-white font-bold text-xs">ISO</div>
            <div><h4 class="font-bold text-espresso">ISO 9001:2015</h4><p class="text-xs text-warmgrey">Quality Management System</p></div>
          </div>
          <div class="flex items-center gap-4 bg-white p-4 rounded-2xl shadow-sm">
            <div class="w-12 h-12 bg-espresso rounded-full flex items-center justify-center text-white font-bold text-xs">GBC</div>
            <div><h4 class="font-bold text-espresso">Green Building Council</h4><p class="text-xs text-warmgrey">Sustainable Materials Partner</p></div>
          </div>
          <div class="flex items-center gap-4 bg-white p-4 rounded-2xl shadow-sm">
            <div class="w-12 h-12 bg-espresso rounded-full flex items-center justify-center text-white font-bold text-xs">SNI</div>
            <div><h4 class="font-bold text-espresso">SNI Certified</h4><p class="text-xs text-warmgrey">Standar Nasional Indonesia</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
